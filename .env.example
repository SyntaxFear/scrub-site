# Public site analytics. Leave unset to disable PostHog locally.
NEXT_PUBLIC_POSTHOG_KEY=

# Convex native-auth backend.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
GOOGLE_NATIVE_CLIENT_ID=
SCRUB_ADMIN_API_KEY=

# Email sign-in delivery through AWS SES.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_FROM=

# Optional local browser-contract test controls.
CHROME_PATH=
SKIP_BROWSER_TESTS=
